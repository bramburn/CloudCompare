echo [sandbox-build] CC=%CC%

:: ── Dispatch ────────────────────────────────────────────────────────────────
set "CMD=%~1"

if "%CMD%"=="" goto check
if "%CMD%"=="check" goto check
if "%CMD%"=="build" goto build
if "%CMD%"=="test" goto test
